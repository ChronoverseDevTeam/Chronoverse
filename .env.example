# Chronoverse Configuration
# Copy this file to .env and adjust values.

# crv-core server
CRV_HOST=0.0.0.0
CRV_PORT=3000
CRV_TICKET_SECRET=change-me-in-production-use-a-long-random-string
CRV_TICKET_TTL_HOURS=24
CRV_DEPOT_ROOT=./data/depot

# PostgreSQL connection
DATABASE_URL=postgres://chronoverse:chronoverse@localhost:5432/chronoverse?sslmode=disable
